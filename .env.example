# --- Google integration (optional) -----------------------------------------
# Enables "Sign in with Google" (per-person login) and Google Drive access.
# Both features are disabled and degrade gracefully until these are set.
#
# 1. Create a project at https://console.cloud.google.com/
# 2. Configure the OAuth consent screen.
# 3. Create an OAuth 2.0 Client ID (type: Web application). Add your app's
#    origin (e.g. http://localhost:3000) to "Authorized JavaScript origins".
# 4. Create an API key (used by the Drive Picker) and restrict it to the
#    "Google Picker API".
#
# These are NEXT_PUBLIC_* because Google Identity Services and the Picker run
# entirely in the browser; the client ID and API key are not secrets.

NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_API_KEY=
